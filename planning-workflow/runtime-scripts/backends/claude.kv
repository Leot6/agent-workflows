# claude — the Anthropic CLI. Effort is xhigh and not max by owner direction.
# Same family as the author, so an instrument bound here buys lineage
# independence and not cognitive diversity — that is the trade the binding map
# records, not a property of this file.
# TWIN DECLARATION: delivery-workflow/config/backends/claude.kv is this same
# CLI's other declaration, under delivery's own driver and key set. A claude
# CLI update moves BOTH; recalibrate the two together or neither.
model=opus
effort=xhigh
cmd.launch=claude --model "{model}" --effort {effort} --permission-mode dontAsk --add-dir {scratch} --add-dir {topic} --add-dir {checkout}
composer=❯
settle=8
modal_max=3
