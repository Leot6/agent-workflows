#!/bin/sh
# commit-msg — this repository's commit-message convention, and the privacy
# scan over the message. Also run by CI on every pushed commit:
#   .githooks/commit-msg <message-file>
#
# Convention (README, Repo conventions):
#   subject  one line, at most 72 characters
#   body     optional; after one blank line, at most 8 lines of at most 72
#            characters — the what and the why; detail belongs in the tree
#   no attribution trailers (Co-Authored-By, Claude-Session, Signed-off-by …):
#   the author field is the attribution, and a session link is private.
MSG=${1:?usage: commit-msg <message-file>}
ROOT=$(git rev-parse --show-toplevel) || exit 1

"$ROOT/privacy_scan.sh" --message "$MSG" || exit 1

perl -CSD -e '
  my @l = grep { !/^#/ } map { chomp; $_ } <STDIN>;
  pop @l while @l && $l[-1] =~ /^\s*$/;
  my @bad;
  my $subject = $l[0] // "";
  push @bad, "empty subject" if $subject =~ /^\s*$/;
  push @bad, sprintf("subject is %d characters (max 72)", length $subject) if length $subject > 72;
  my @body = @l[1 .. $#l];
  if (@body) {
    push @bad, "line 2 must be blank (subject, blank line, body)" if $body[0] ne "";
    shift @body while @body && $body[0] eq "";
    push @bad, sprintf("body is %d lines (max 8)", scalar @body) if @body > 8;
    for my $i (0 .. $#body) {
      push @bad, sprintf("body line %d is %d characters (max 72)", $i + 1, length $body[$i])
        if length $body[$i] > 72;
      push @bad, "attribution trailer: $1 (the author field is the attribution)"
        if $body[$i] =~ /^([A-Za-z-]*(Co-Authored-By|Signed-off-by|Session|Generated[- ]with)[A-Za-z-]*):/i
        || $body[$i] =~ /^(Claude-[A-Za-z-]+):/i;
    }
  }
  if (@bad) { print STDERR "commit-msg: $_\n" for @bad; exit 1 }
' < "$MSG"
