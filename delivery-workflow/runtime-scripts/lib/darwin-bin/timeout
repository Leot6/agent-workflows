#!/usr/bin/perl
# timeout — macOS stand-in for the GNU command (lib/platform.sh puts this
# directory first on PATH on macOS). The semantics this tree
# relies on: DURATION[smhd] (fractions allowed); rc 124 when the limit fired,
# 128+N when the command died of signal N, its own rc otherwise; the command
# runs in its own process group and the whole group is signalled.
use strict; use warnings; use Time::HiRes qw(alarm);
my $d = shift // '';
if ($d =~ /^-/ || !@ARGV) { print STDERR "timeout (darwin-bin): usage: timeout DURATION COMMAND... (no options)\n"; exit 125 }
my $m = 1;
if ($d =~ s/([smhd])$//) { $m = { s => 1, m => 60, h => 3600, d => 86400 }->{$1} }
$d =~ /^\d+(?:\.\d+)?$/ or do { print STDERR "timeout: invalid time interval\n"; exit 125 };
my $secs = $d * $m;
my $pid = fork; defined $pid or exit 125;
if ($pid == 0) { setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127 }
my $fired = 0;
$SIG{ALRM} = sub { $fired = 1; kill 'TERM', -$pid };
$SIG{$_} = sub { kill $_[0], -$pid } for qw(TERM INT HUP);
alarm $secs if $secs > 0;
while (waitpid($pid, 0) < 0) { last unless $!{EINTR} }
my $st = $?;
exit 124 if $fired;
exit(($st & 127) ? 128 + ($st & 127) : $st >> 8);
